# Required in production. Any long random string.
SESSION_SECRET=

# Google account that becomes the first administrator when the workspace has none.
BOOTSTRAP_ADMIN_EMAIL=

# PostgreSQL workspace database and Redis for sessions, tokens, limits, and the write lock.
# Host port 5433 avoids a PostgreSQL server already installed on 5432.
DATABASE_URL=postgres://goyal:goyal@localhost:5433/goyal_workspace
REDIS_URL=redis://localhost:6379

# Public OAuth client id. The client secret must stay on the server.
# Google is used for sign-in and calendar, not for storing the workspace.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:5174/api/google/calendar/callback

PORT=5175
# Set true when the site is served over HTTPS.
COOKIE_SECURE=
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=

# Private object storage. Leave blank to keep files on local disk.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false
