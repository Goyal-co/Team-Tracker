# ============================================================================
# Team Tracker - environment
# Copy to .env and fill in. .env is git-ignored and passed to the container by
# docker-compose (env_file). Never commit real values.
# ============================================================================

# Required in production. Any long random string (>= 16 chars).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Google account that becomes the first administrator when the workspace has
# none. Required in production.
BOOTSTRAP_ADMIN_EMAIL=

# --- Data stores (already running on the EC2 host) -------------------------
# The container reaches the host through host.docker.internal (see the
# extra_hosts mapping in docker-compose.yml).
#
# PostgreSQL must listen on the Docker bridge (set listen_addresses = '*' and
# allow 172.16.0.0/12 in pg_hba.conf). The database is created automatically
# if the configured user may create databases; otherwise create it first.
DATABASE_URL=postgres://goyal:goyal@host.docker.internal:5432/goyal_workspace
REDIS_URL=redis://host.docker.internal:6379

# Local development with compose.local.yml (its postgres is published on host
# port 5433). Use these two lines instead while running `npm run dev`:
# DATABASE_URL=postgres://goyal:goyal@localhost:5433/goyal_workspace
# REDIS_URL=redis://localhost:6379

# Redis holds sessions, Google tokens, rate limits, and the write lock.
# Redis must bind to an address the container can reach (default is
# 127.0.0.1 only). If REDIS_URL is empty or unreachable, the app falls back
# to PostgreSQL for all of it.

# --- Google sign-in and calendar ------------------------------------------
# Redirect URI must match the public URL, path /api/google/calendar/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tracker.example.com/api/google/calendar/callback

# --- HTTP -----------------------------------------------------------------
PORT=5175
# Set true when the site is served over HTTPS (nginx / load balancer).
COOKIE_SECURE=true
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=true

# --- File storage ---------------------------------------------------------
# Private object storage (S3 / MinIO). Leave blank to keep files on local
# disk under DATA_DIR/uploads (persisted by the ./data volume).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false

# Where uploads and legacy data files live inside the container.
DATA_DIR=/app/data

# --- Web Push (optional) ----------------------------------------------------
# Generate once: npx web-push generate-vapid-keys
# Without these, in-app notifications still work; OS push alerts stay off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
